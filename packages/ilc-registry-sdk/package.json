{
    "name": "ilc-registry-sdk",
    "version": "0.3.1",
    "description": "SDK for the ILC Registry API",
    "keywords": [
        "ilc",
        "ilc-registry",
        "micro-frontends"
    ],
    "author": "Namecheap",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/namecheap/ilc-packages.git",
        "directory": "packages/ilc-registry-sdk"
    },
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
        "ilc-registry": "./dist/bin/ilc-registry.js"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./auth": {
            "types": "./dist/auth/index.d.ts",
            "default": "./dist/auth/index.js"
        }
    },
    "imports": {
        "#token-store": {
            "node": "./dist/node/token-store.js",
            "default": "./dist/node/token-store.unsupported.js"
        }
    },
    "typesVersions": {
        "*": {
            "auth": [
                "./dist/auth/index.d.ts"
            ]
        }
    },
    "files": [
        "dist",
        "!dist/*.tsbuildinfo"
    ],
    "engines": {
        "node": "^22"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsc -b tsconfig.lib.json",
        "clean": "rm -rf dist",
        "test": "vitest run",
        "typecheck": "tsc -b"
    },
    "dependencies": {
        "lzutf8": "^0.6.3"
    }
}
