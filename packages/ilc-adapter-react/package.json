{
    "name": "ilc-adapter-react",
    "version": "4.0.0",
    "description": "Adapter for React applications and parcels running in ILC",
    "keywords": [
        "ilc",
        "micro-frontends",
        "react",
        "single-spa",
        "parcel"
    ],
    "author": "Namecheap, Inc",
    "license": "Apache-2.0",
    "homepage": "https://github.com/namecheap/ilc-packages/tree/master/packages/ilc-adapter-react#readme",
    "bugs": {
        "url": "https://github.com/namecheap/ilc-packages/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/namecheap/ilc-packages.git",
        "directory": "packages/ilc-adapter-react"
    },
    "type": "commonjs",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./parcel": {
            "types": "./dist/parcel.d.ts",
            "default": "./dist/parcel.js"
        },
        "./server": {
            "types": "./dist/server.d.ts",
            "default": "./dist/server.js"
        }
    },
    "files": [
        "dist",
        "!dist/*.tsbuildinfo",
        "parcel.js",
        "parcel.d.ts",
        "server.js",
        "server.d.ts",
        "LICENSE.txt",
        "NOTICE.md"
    ],
    "engines": {
        "node": ">=18"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsc -b tsconfig.lib.json",
        "clean": "rm -rf dist",
        "test": "vitest run",
        "typecheck": "tsc -b"
    },
    "peerDependencies": {
        "ilc-sdk": ">=6.1.1",
        "react": "~18.2.0",
        "react-dom": "~18.2.0"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.3",
        "@types/react": "~18.3.31",
        "@types/react-dom": "~18.3.7",
        "ilc-sdk": "workspace:^",
        "jsdom": "^30.1.3",
        "react": "~18.2.0",
        "react-dom": "~18.2.0"
    }
}
