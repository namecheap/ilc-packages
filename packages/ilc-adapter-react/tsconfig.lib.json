{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "composite": true,
        "target": "es2019",
        "lib": ["es2019", "dom"],
        "types": ["node"],
        "rootDir": "src",
        "outDir": "dist",
        "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo"
    },
    "include": ["src/**/*.ts", "src/**/*.tsx"],
    "exclude": ["src/**/*.spec.ts", "src/**/*.spec.tsx"]
}
