{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "composite": true,
        "target": "es2019",
        "types": ["node"],
        "rootDir": "src",
        "outDir": "dist",
        "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo"
    },
    "include": ["src/**/*.ts"],
    "exclude": ["src/**/*.spec.ts", "src/webpack/fixture/**"]
}
